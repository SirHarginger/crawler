{
  "dataset": "external_research_dev",
  "version": "dev-v1",
  "created": "2026-10-11",
  "author": "the implementer; DEV set, may be used while engineering",
  "scope": "Public figures and public-interest organisations only (Ghana first, then other African states and bodies). Name, role or organisation, and country: nothing else is sent to the search provider.",
  "requirements_status": "Set by the owner on 2026-10-11 as Trustora pilot engineering gates, not literature-derived constants. NOT RUN: Exa standard named-person search is not approved; a provider whose terms explicitly support this use (DPA and zero data retention) is required first.",
  "requirements": {
    "api_technical_success_min": 0.95,
    "relevant_lead_hit_at_5_min": 0.9,
    "reported_not_gated": [
      "official-source Hit@5 on the subset of subjects pre-labelled as having an official source",
      "fetch and mention rate of relevant leads"
    ],
    "definitions": {
      "api technical success": "the search call returned a well-formed result list",
      "relevant lead": "a lead in the top 5 whose host is, or is a subdomain of, one of the subject's official_hosts or one of credible_hosts",
      "official-source Hit@5": "a lead in the top 5 on one of the subject's official_hosts; only subjects with a non-empty official_hosts list are counted"
    }
  },
  "credible_hosts": [
