{
  "dataset": "external_research_fetch_dev",
  "version": "fetch-dev-v1",
  "created": "2026-10-11",
  "author": "the implementer, from the platform's own records and the publishers' and authorities' own sites; no search provider was used",
  "frozen": "Frozen before execution. The SHA-256 of this file is recorded in the result and in the research record. No URL is added, removed or relabelled after a run.",
  "scope": "Public pages only: Ghana government and Parliament, sanctions authorities, and Ghanaian publishers already registered as sources. Names are of sitting public officials and appear only as the string a page is expected to contain.",
  "labels": {
    "format": "html = eligible for the gates; pdf and js_app are known unsupported formats, fetched to record what happens and reported separately",
    "expected_mention": "a string the page is known to contain (from the headline or the record the URL came from); null where the page is not about a named subject"
  },
  "gates": {
    "eligible_fetch_success_min": 0.9,
    "usable_extraction_min": 0.9,
    "subject_mention_recovered_min": 0.9,
    "network_policy_violations_max": 0,
    "ungoverned_outbound_requests_max": 0,
    "set_by": "owner, 2026-10-11; Trustora pilot engineering gates",
    "definitions": {
      "eligible page": "format html",
      "fetch success": "the gateway returned a 2xx HTML response for an eligible page (a robots refusal, HTTP error, timeout or oversize counts against it)",
      "usable extraction": "of eligible pages fetched successfully and not classified js_required or consent_wall, article text was extracted",
      "subject mention recovered": "of eligible pages with an expected_mention that yielded text, the text contains it",
      "network policy violation": "a connection to an address that is not public, or a request the gateway would refuse",
      "ungoverned outbound request": "a connection from the evaluation process to an address the gateway did not validate for a URL in this list, or any socket attempt inside the parsing child"
    }
  },
