{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:screening-crawler:schema:source-record:1",
  "title": "Layer 1 source record",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "dataset_key", "snapshot_id", "artifact_ids", "record_kind", "source_record_key", "locator", "parsed", "content_sha256", "parser_version", "observed_from", "observed_to", "asserted_valid_from", "asserted_valid_to", "precision"],
  "properties": {
    "id": {"type": "string", "format": "uuid"},
    "dataset_key": {"type": "string"},
    "snapshot_id": {"type": "string", "format": "uuid"},
    "artifact_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "format": "uuid"}},
    "record_kind": {"type": "string"},
    "source_record_key": {"type": "string"},
    "locator": {"type": "string"},
    "parsed": {"type": "object"},
    "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "parser_version": {"type": "string"},
    "observed_from": {"type": "string", "format": "date-time"},
    "observed_to": {"type": ["string", "null"], "format": "date-time"},
    "asserted_valid_from": {"type": ["string", "null"]},
    "asserted_valid_to": {"type": ["string", "null"]},
    "precision": {"enum": ["exact", "month", "year", "unknown"]}
  }
}
