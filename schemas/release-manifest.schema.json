{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/screening/release-manifest-v1.json",
  "title": "Screening crawler release manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "release_id", "release_schema_version", "status", "generated_at",
    "ftm_schema_version", "mapping_version", "normalization_version",
    "crawler_version", "crawler_revision", "deterministic_id_method", "datasets", "snapshots", "files"
  ],
  "properties": {
    "release_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "release_schema_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$"},
    "status": {"const": "PUBLISHED"},
    "generated_at": {"type": "string", "format": "date-time"},
    "ftm_schema_version": {"type": "string", "minLength": 1},
    "mapping_version": {"type": "string", "minLength": 1},
    "normalization_version": {"type": "string", "minLength": 1},
    "crawler_version": {"type": "string", "minLength": 1},
    "crawler_revision": {"type": "string", "pattern": "^[0-9a-f]{7,64}$"},
    "deterministic_id_method": {"type": "string", "minLength": 1},
    "datasets": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["key", "version", "entity_count", "source_record_count", "projection_statement_count", "freshness_checked_at"],
        "properties": {
          "key": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_]{1,63}$"},
          "version": {"type": "string", "minLength": 1},
          "entity_count": {"type": "integer", "minimum": 0},
          "source_record_count": {"type": "integer", "minimum": 0},
          "projection_statement_count": {"type": "integer", "minimum": 0},
          "publication_date": {"type": ["string", "null"], "format": "date-time"},
          "freshness_checked_at": {"type": "string", "format": "date-time"}
        }
      }
    },
    "snapshots": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": true,
        "required": ["id", "dataset_key", "state", "combined_manifest_sha256", "completeness_evidence"],
        "properties": {
          "id": {"type": "string", "format": "uuid"},
          "dataset_key": {"type": "string"},
          "state": {"enum": ["FETCHING", "INCOMPLETE", "COMPLETE", "QUARANTINED", "PUBLISHED", "SUPERSEDED"]},
          "combined_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "completeness_evidence": {"type": "object", "minProperties": 1}
        }
      }
    },
    "files": {
      "type": "array", "minItems": 5,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["path", "role", "sha256", "size_bytes", "media_type", "datasets"],
        "properties": {
          "path": {"type": "string", "pattern": "^(?!/)(?!.*\\.\\.).+$"},
          "role": {"enum": ["checksums", "snapshot", "artifacts", "source_records", "source_record_extents", "source_interpretations", "projection_statements", "entities", "field_coverage", "validation_report", "pep_assertions"]},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "size_bytes": {"type": "integer", "minimum": 0},
          "media_type": {"type": "string", "minLength": 1},
          "datasets": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true}
        }
      }
    }
  }
}
